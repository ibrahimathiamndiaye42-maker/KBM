NODE_ENV=production
PORT=4000
# PostgreSQL hébergé (Neon, Supabase, Render, Railway...)
DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/kmb
DATABASE_SSL=true
# Chaîne aléatoire de 32 caractères minimum : openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=12h
# Domaine(s) du frontend, séparés par des virgules (utile surtout en développement)
CORS_ORIGIN=http://localhost:5173

# --- Notifications WhatsApp (API officielle Meta) — facultatif, voir README ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Nom du modèle de message approuvé par Meta (recommandé). Vide = message texte libre (limité à 24 h après un message de l'institut).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=fr
